<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
    <link rel="stylesheet" href="/pixel-theme.css">
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css">
    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            margin: 0;
            background: var(--pixel-bg-dark);
            background-image: 
                radial-gradient(circle at 50% 40%, rgba(255, 51, 119, 0.1) 0%, transparent 60%),
                linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
            background-size: 100% 100%, 20px 20px, 20px 20px;
        }

        .error-container {
            max-width: 520px;
            width: 100%;
            padding: 36px 28px;
            text-align: center;
        }

        .error-number {
            font-family: var(--font-pixel-heading);
            font-size: 56px;
            color: var(--pixel-secondary);
            text-shadow: 4px 4px 0px #000;
            margin-bottom: 16px;
        }

        .error-container h2 {
            font-family: var(--font-pixel-heading);
            font-size: 18px;
            color: var(--pixel-yellow);
            margin-bottom: 14px;
        }

        .error-container p {
            color: var(--pixel-text-dim);
            font-size: 12px;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .requested-url {
            background: #0d0f1c;
            border: 2px solid #000;
            padding: 10px;
            font-family: var(--font-pixel-code);
            font-size: 18px;
            color: var(--pixel-primary);
            word-break: break-all;
            margin-bottom: 20px;
            text-align: left;
        }

        .suggestions {
            background: #14172b;
            border: 3px solid #000;
            padding: 16px;
            margin-bottom: 24px;
            text-align: left;
        }

        .suggestions h3 {
            font-family: var(--font-pixel-heading);
            font-size: 11px;
            color: var(--pixel-yellow);
            margin-bottom: 12px;
        }

        .suggestions ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .suggestions li {
            margin-bottom: 8px;
            font-size: 12px;
        }

        .suggestions a {
            color: var(--pixel-primary);
            text-decoration: none;
        }

        .suggestions a:hover {
            text-decoration: underline;
        }

        .action-buttons {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
        }
    </style>
</head>
<body>
    <div class="pixel-box error-container">
        <div class="error-number">404</div>
        <h2>GAME OVER / PAGE NOT FOUND</h2>
        <p>The pixel stage you're searching for does not exist or has been moved to another location.</p>

        <div class="requested-url">
            <strong>URL:</strong> <%= url %>
        </div>

        <div class="suggestions">
            <h3><i class="fa-solid fa-compass"></i> TRY THESE PATHS:</h3>
            <ul>
                <li><i class="fa-solid fa-house"></i> <a href="/landing">Return to Home Page</a></li>
                <% if (typeof user !== 'undefined' && user) { %>
                    <li><i class="fa-solid fa-code"></i> <a href="/editor">Open Code Editor</a></li>
                    <li><i class="fa-solid fa-user"></i> <a href="/profile">View Profile</a></li>
                <% } else { %>
                    <li><i class="fa-solid fa-right-to-bracket"></i> <a href="/login">Sign In</a></li>
                <% } %>
            </ul>
        </div>

        <div class="action-buttons">
            <a href="/landing" class="pixel-btn">
                <i class="fa-solid fa-house"></i> Home Page
            </a>
            <a href="javascript:history.back()" class="pixel-btn secondary">
                <i class="fa-solid fa-arrow-left"></i> Go Back
            </a>
        </div>
    </div>
</body>
</html>