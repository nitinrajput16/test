<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
    <link rel="stylesheet" href="/pixel-theme.css">
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css">
    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            margin: 0;
            background: var(--pixel-bg-dark);
            background-image: 
                radial-gradient(circle at 50% 30%, rgba(255, 51, 119, 0.08) 0%, transparent 60%),
                linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
            background-size: 100% 100%, 20px 20px, 20px 20px;
        }

        .signup-box {
            max-width: 480px;
            width: 100%;
            padding: 32px 28px;
            text-align: center;
        }

        .signup-logo {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            margin-bottom: 12px;
        }

        .subtitle {
            font-size: 12px;
            color: var(--pixel-yellow);
            margin-bottom: 24px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .alert-box {
            padding: 12px;
            border: 3px solid #000;
            box-shadow: 3px 3px 0 #000;
            font-size: 11px;
            margin-bottom: 20px;
            text-align: left;
            background: #38121d;
            color: var(--pixel-secondary);
        }

        .form-group {
            margin-bottom: 16px;
            text-align: left;
        }

        .form-group label {
            display: block;
            font-size: 11px;
            color: var(--pixel-primary);
            margin-bottom: 6px;
            font-family: var(--font-pixel-body);
        }

        .pwd-req {
            font-size: 10px;
            color: var(--pixel-text-dim);
            margin-top: 4px;
        }

        .divider {
            margin: 24px 0;
            position: relative;
            text-align: center;
        }

        .divider::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--pixel-border-inner);
        }

        .divider span {
            position: relative;
            background: var(--pixel-bg-card);
            padding: 0 12px;
            color: var(--pixel-text-dim);
            font-size: 10px;
            font-family: var(--font-pixel-heading);
        }

        .oauth-buttons {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .login-link {
            margin-top: 20px;
            font-size: 12px;
            color: var(--pixel-text-dim);
        }

        .login-link a {
            color: var(--pixel-primary);
            text-decoration: none;
        }

        .login-link a:hover {
            text-decoration: underline;
        }
    </style>
<%- include('partials/theme-head') %>
</head>
<body data-page="signup">
<%- include('partials/theme-header') %>
    <div class="pixel-box signup-box">
        <div class="signup-logo">
            <div class="logo-sprite"></div>
            <div class="logo-text" style="font-size: 22px;">Code<span>plat</span></div>
        </div>
        <div class="subtitle"><%= themeV2 ? 'Create your account' : 'Create Pixel Account' %></div>

        <% if (error) { %>
            <div class="alert-box">
                ⚠️ <%= decodeURIComponent(error) %>
            </div>
        <% } %>

        <% const nextQuery = next ? ('?next=' + encodeURIComponent(next)) : ''; %>

        <form method="POST" action="/auth/signup<%= nextQuery %>">
            <div class="form-group">
                <label for="email"><i class="fa-solid fa-envelope"></i> Email Address</label>
                <input type="email" id="email" name="email" class="pixel-input" required placeholder="you@example.com">
            </div>

            <div class="form-group">
                <label for="displayName"><i class="fa-solid fa-user"></i> Display Name (Optional)</label>
                <input type="text" id="displayName" name="displayName" class="pixel-input" placeholder="John Doe">
            </div>

            <div class="form-group">
                <label for="password"><i class="fa-solid fa-key"></i> Password</label>
                <input type="password" id="password" name="password" class="pixel-input" required placeholder="••••••••">
                <div class="pwd-req">At least 8 characters with upper, lower, & numbers</div>
            </div>

            <div class="form-group">
                <label for="confirmPassword"><i class="fa-solid fa-shield-halved"></i> Confirm Password</label>
                <input type="password" id="confirmPassword" name="confirmPassword" class="pixel-input" required placeholder="••••••••">
            </div>

            <button type="submit" class="pixel-btn secondary" style="width: 100%; margin-top: 8px;">
                <i class="fa-solid fa-user-plus"></i> Create Account
            </button>
        </form>

        <div class="divider"><span>OR</span></div>

        <div class="oauth-buttons">
            <a href="/auth/google<%= nextQuery %>" class="pixel-btn btn-dark">
                <i class="fa-brands fa-google" style="color: #ea4335;"></i> Continue with Google
            </a>
            <a href="/auth/github<%= nextQuery %>" class="pixel-btn btn-dark">
                <i class="fa-brands fa-github"></i> Continue with GitHub
            </a>
        </div>

        <div class="login-link">
            Already have an account? <a href="/login<%= nextQuery %>">Sign In</a>
        </div>
    </div>
<%- include('partials/theme-controls') %>
</body>
</html>
