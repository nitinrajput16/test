<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
    <link rel="stylesheet" href="/pixel-theme.css">
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css">
    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            margin: 0;
            background: var(--pixel-bg-dark);
            background-image: 
                radial-gradient(circle at 50% 30%, rgba(0, 255, 204, 0.08) 0%, transparent 60%),
                linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
            background-size: 100% 100%, 20px 20px, 20px 20px;
        }

        .login-box {
            max-width: 440px;
            width: 100%;
            padding: 32px 28px;
            text-align: center;
        }

        .login-logo {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            margin-bottom: 12px;
        }

        .subtitle {
            font-size: 12px;
            color: var(--pixel-yellow);
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .author {
            color: var(--pixel-text-dim);
            font-size: 11px;
            margin-bottom: 24px;
        }

        .alert-box {
            padding: 12px;
            border: 3px solid #000;
            box-shadow: 3px 3px 0 #000;
            font-size: 11px;
            margin-bottom: 20px;
            text-align: left;
        }

        .alert-box.error {
            background: #38121d;
            color: var(--pixel-secondary);
            border-color: #000;
        }

        .alert-box.success {
            background: #092c24;
            color: var(--pixel-primary);
            border-color: #000;
        }

        .form-group {
            margin-bottom: 18px;
            text-align: left;
        }

        .form-group label {
            display: block;
            font-size: 11px;
            color: var(--pixel-primary);
            margin-bottom: 8px;
            font-family: var(--font-pixel-body);
        }

        .divider {
            margin: 24px 0;
            position: relative;
            text-align: center;
        }

        .divider::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--pixel-border-inner);
        }

        .divider span {
            position: relative;
            background: var(--pixel-bg-card);
            padding: 0 12px;
            color: var(--pixel-text-dim);
            font-size: 10px;
            font-family: var(--font-pixel-heading);
        }

        .oauth-buttons {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .oauth-btn {
            flex: 1;
            min-width: 140px;
            font-size: 10px;
        }

        .signup-link {
            margin-top: 20px;
            font-size: 12px;
            color: var(--pixel-text-dim);
        }

        .signup-link a {
            color: var(--pixel-primary);
            text-decoration: none;
        }

        .signup-link a:hover {
            text-decoration: underline;
        }

        .login-footer {
            margin-top: 24px;
            padding-top: 14px;
            border-top: 2px solid var(--pixel-border-inner);
            color: var(--pixel-text-muted);
            font-size: 10px;
        }
    </style>
<%- include('partials/theme-head') %>
</head>
<body data-page="login">
<%- include('partials/theme-header') %>
    <div class="pixel-box login-box">
        <div class="login-logo">
            <div class="logo-sprite"></div>
            <div class="logo-text" style="font-size: 22px;">Code<span>plat</span></div>
        </div>
        <div class="subtitle"><%= themeV2 ? 'Your shared coding workspace' : 'Pixel Collaborative IDE' %></div>
        <div class="author">by nitinrajput16</div>

        <% if (error === 'auth_required') { %>
            <div class="alert-box error">
                🔒 You must log in to access this page
            </div>
        <% } else if (error) { %>
            <div class="alert-box error">
                ⚠️ <%= decodeURIComponent(error) %>
            </div>
        <% } %>

        <% if (message === 'logged_out') { %>
            <div class="alert-box success">
                ✅ Successfully logged out
            </div>
        <% } %>

        <% const nextQuery = next ? ('?next=' + encodeURIComponent(next)) : ''; %>

        <form method="POST" action="/auth/login<%= nextQuery %>">
            <div class="form-group">
                <label for="email"><i class="fa-solid fa-envelope"></i> Email Address</label>
                <input type="email" id="email" name="email" class="pixel-input" required placeholder="you@example.com">
            </div>

            <div class="form-group">
                <label for="password"><i class="fa-solid fa-key"></i> Password</label>
                <input type="password" id="password" name="password" class="pixel-input" required placeholder="••••••••">
            </div>

            <button type="submit" class="pixel-btn" style="width: 100%; margin-top: 8px;">
                <i class="fa-solid fa-right-to-bracket"></i> Sign In
            </button>
        </form>

        <div class="signup-link">
            Don't have an account? <a href="/signup<%= nextQuery %>">Sign Up</a>
        </div>

        <div class="divider"><span>OR</span></div>

        <div class="oauth-buttons">
            <a href="/auth/google<%= nextQuery %>" class="pixel-btn oauth-btn btn-dark">
                <i class="fa-brands fa-google" style="color: #ea4335;"></i> Google
            </a>
            <a href="/auth/github<%= nextQuery %>" class="pixel-btn oauth-btn btn-dark">
                <i class="fa-brands fa-github"></i> GitHub
            </a>
        </div>

        <div class="login-footer">
            <div><%= themeV2 ? 'Sign in with your account or a connected provider' : 'Secure 8-Bit OAuth Authentication' %></div>
            <div style="margin-top: 4px; color: var(--pixel-primary);">
                <%= new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }) %> IST
            </div>
        </div>
    </div>
<%- include('partials/theme-controls') %>
</body>
</html>
