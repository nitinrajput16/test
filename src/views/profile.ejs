<script>
(function () {
  const ownProfile = document.body.dataset.ownProfile === 'true';
  const sectionLinks = Array.from(document.querySelectorAll('[data-section-link]'));
  const sections = Array.from(document.querySelectorAll('.pf-section'));
  const sectionTitle = document.getElementById('sectionTitle');
  const sectionLead = document.getElementById('sectionLead');

  function updateActiveNav(sectionName) {
    sectionLinks.forEach((link) => {
      link.classList.toggle('active', link.dataset.sectionLink === sectionName);
    });
  }

  function activateSection(sectionName, syncHash) {
    const target = sections.find((section) => section.dataset.section === sectionName) || sections[0];
    if (!target) return;

    sections.forEach((section) => {
      section.classList.toggle('active', section === target);
    });
    updateActiveNav(target.dataset.section);
    if (sectionTitle) sectionTitle.textContent = target.dataset.title || 'Profile';
    if (sectionLead) sectionLead.textContent = target.dataset.lead || '';
    if (syncHash) {
      const nextHash = '#' + target.dataset.section;
      if (window.location.hash !== nextHash) window.history.replaceState(null, '', nextHash);
    }
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  sectionLinks.forEach((link) => {
    link.addEventListener('click', () => activateSection(link.dataset.sectionLink, true));
  });

  document.querySelectorAll('[data-open-section]').forEach((button) => {
    button.addEventListener('click', () => activateSection(button.dataset.openSection, true));
  });

  activateSection(window.location.hash ? window.location.hash.slice(1) : 'profile', false);
  window.addEventListener('hashchange', () => activateSection(window.location.hash.slice(1) || 'profile', false));

  function setBanner(element, message, isError) {
    if (!element) return;
    element.className = 'pf-banner ' + (isError ? 'error' : 'success');
    element.textContent = message;
    element.style.display = 'block';
  }

  function clearBanner(element) {
    if (!element) return;
    element.textContent = '';
    element.className = 'pf-banner';
    element.style.display = 'none';
  }

  function updateProfileTexts(nextUser) {
    if (!nextUser) return;

    document.querySelectorAll('[data-profile-name]').forEach((node) => {
      if (typeof nextUser.displayName === 'string') node.textContent = nextUser.displayName;
    });
    document.querySelectorAll('[data-profile-handle]').forEach((node) => {
      if (typeof nextUser.username === 'string') node.textContent = '@' + nextUser.username;
    });
    document.querySelectorAll('[data-profile-email]').forEach((node) => {
      if (typeof nextUser.email === 'string') node.textContent = nextUser.email;
    });
    document.querySelectorAll('[data-profile-avatar]').forEach((node) => {
      if (typeof nextUser.avatar === 'string') node.src = nextUser.avatar || '/images/favicon.ico';
    });

    const avatarInput = document.getElementById('pf_avatar');
    if (avatarInput && typeof nextUser.avatar === 'string') avatarInput.value = nextUser.avatar;
    const emailInput = document.getElementById('cred_email');
    if (emailInput && typeof nextUser.email === 'string') emailInput.value = nextUser.email;
  }

  function updateFriendCounters() {
    const count = document.querySelectorAll('#friendList .pf-friend-item').length;
    const countNode = document.getElementById('friendCount');
    const tagNode = document.getElementById('friendCountTag');
    if (countNode) countNode.textContent = String(count);
    if (tagNode) tagNode.textContent = String(count);
  }

  function ensureNoFriendsState() {
    const list = document.getElementById('friendList');
    if (!list) return;
    const hasFriends = list.querySelector('.pf-friend-item');
    const empty = document.getElementById('noFriendsMsg');
    if (!hasFriends && !empty) {
      const state = document.createElement('div');
      state.className = 'pf-empty';
      state.id = 'noFriendsMsg';
      state.textContent = 'No friends added yet. Use the add form to build your list.';
      list.appendChild(state);
    }
  }

  function removeNoFriendsState() {
    const empty = document.getElementById('noFriendsMsg');
    if (empty) empty.remove();
  }

  function bindRemoveFriendButtons() {
    document.querySelectorAll('.pf-remove-friend-btn').forEach((button) => {
      if (button.dataset.bound === '1') return;
      button.dataset.bound = '1';
      button.addEventListener('click', async () => {
        const username = button.dataset.uname;
        const msg = document.getElementById('friendMsg');
        button.disabled = true;
        button.textContent = 'Removing';
        clearBanner(msg);
        try {
          const response = await fetch('/profile/friends/remove', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username })
          });
          const data = await response.json();
          if (!response.ok || !data.success) throw new Error(data.error || 'Could not remove friend.');
          const row = document.querySelector('.pf-friend-item[data-uname="' + username + '"]');
          if (row) row.remove();
          updateFriendCounters();
          ensureNoFriendsState();
          setBanner(msg, 'Friend removed.', false);
        } catch (error) {
          setBanner(msg, error.message || 'Network error while removing friend.', true);
        }
        button.disabled = false;
        button.textContent = 'Remove';
      });
    });
  }

  bindRemoveFriendButtons();
  if (!ownProfile) return;

  const profileForm = document.getElementById('profileForm');
  const usernameInput = document.getElementById('pf_username');
  const profileNameInput = document.getElementById('pf_displayName');
  const checkButton = document.getElementById('pf_checkBtn');
  const usernameStatus = document.getElementById('pf_usernameStatus');
  const profileMsg = document.getElementById('profileMsg');
  const profileSave = document.getElementById('pf_saveBtn');
  let usernameValid = true;
  let lastCheckedUsername = usernameInput ? usernameInput.value.trim().toLowerCase() : '';

  function setUsernameStatus(message, isError) {
    if (!usernameStatus) return;
    usernameStatus.textContent = message;
    usernameStatus.style.color = isError ? '#ffd0d0' : message ? '#bdf7d4' : 'var(--text-faint)';
  }

  usernameInput && usernameInput.addEventListener('input', () => {
    const nextValue = usernameInput.value.trim().toLowerCase();
    if (nextValue !== lastCheckedUsername) {
      usernameValid = false;
      setUsernameStatus('Check availability before saving.', false);
    } else {
      usernameValid = true;
      setUsernameStatus('', false);
    }
  });

  checkButton && checkButton.addEventListener('click', async () => {
    const username = usernameInput.value.trim().toLowerCase();
    if (!username) {
      setUsernameStatus('Enter a username first.', true);
      return;
    }
    checkButton.disabled = true;
    checkButton.textContent = 'Checking';
    setUsernameStatus('Checking availability...', false);
    try {
      const response = await fetch('/profile/check-username?username=' + encodeURIComponent(username));
      const data = await response.json();
      if (data.same || data.available) {
        usernameValid = true;
        lastCheckedUsername = username;
        setUsernameStatus(data.same ? 'This is already your username.' : 'Username is available.', false);
      } else {
        usernameValid = false;
        setUsernameStatus(data.error || 'Username is not available.', true);
      }
    } catch (_error) {
      usernameValid = false;
      setUsernameStatus('Network error during username check.', true);
    }
    checkButton.disabled = false;
    checkButton.textContent = 'Check';
  });

  profileForm && profileForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearBanner(profileMsg);
    const username = usernameInput.value.trim().toLowerCase();
    if (username !== lastCheckedUsername && username !== '<%= user.username %>') usernameValid = false;
    if (!usernameValid) {
      setBanner(profileMsg, 'Check username availability before saving.', true);
      return;
    }
    profileSave.disabled = true;
    profileSave.textContent = 'Saving';
    try {
      const response = await fetch('/profile/update', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          displayName: profileNameInput.value.trim(),
          username,
          avatar: document.getElementById('pf_avatar').value.trim()
        })
      });
      const data = await response.json();
      if (!response.ok || !data.success) throw new Error(data.error || 'Profile update failed.');
      lastCheckedUsername = data.user.username;
      usernameValid = true;
      usernameInput.value = data.user.username;
      updateProfileTexts(data.user);
      setUsernameStatus('', false);
      setBanner(profileMsg, data.message || 'Profile updated.', false);
    } catch (error) {
      setBanner(profileMsg, error.message || 'Network error while updating profile.', true);
    }
    profileSave.disabled = false;
    profileSave.textContent = 'Save profile';
  });

  const friendForm = document.getElementById('friendForm');
  const friendInput = document.getElementById('friendInput');
  const addFriendButton = document.getElementById('addFriendBtn');
  const friendMsg = document.getElementById('friendMsg');

  friendForm && friendForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearBanner(friendMsg);
    const username = (friendInput.value || '').trim().toLowerCase();
    if (!username) {
      setBanner(friendMsg, 'Enter a username to add.', true);
      return;
    }
    addFriendButton.disabled = true;
    addFriendButton.textContent = 'Adding';
    try {
      const response = await fetch('/profile/friends/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username })
      });
      const data = await response.json();
      if (!response.ok || !data.success) throw new Error(data.error || 'Could not add friend.');
      removeNoFriendsState();
      if (data.friend) {
        const list = document.getElementById('friendList');
        const row = document.createElement('div');
        row.className = 'pf-friend-item';
        row.dataset.uname = data.friend.username;
        row.innerHTML = '<div class="pf-friend-main"><div class="pf-friend-avatar-wrap"><img class="pf-friend-avatar" src="' + (data.friend.avatar || '/images/favicon.ico') + '" alt="avatar" onerror="this.onerror=null;this.src=\'/images/favicon.ico\'"></div><div style="min-width: 0;"><div class="pf-friend-name"></div><div class="pf-friend-sub"></div></div></div><button type="button" class="pf-btn-secondary pf-remove-friend-btn" data-uname="' + data.friend.username + '"><i class="fa-solid fa-user-minus"></i><span>Remove</span></button>';
        row.querySelector('.pf-friend-name').textContent = data.friend.displayName;
        row.querySelector('.pf-friend-sub').textContent = '@' + data.friend.username;
        list.appendChild(row);
        bindRemoveFriendButtons();
        updateFriendCounters();
      }
      friendInput.value = '';
      setBanner(friendMsg, data.message || 'Friend added.', false);
    } catch (error) {
      setBanner(friendMsg, error.message || 'Network error while adding friend.', true);
    }
    addFriendButton.disabled = false;
    addFriendButton.textContent = 'Add friend';
  });

  const credentialsForm = document.getElementById('credentialsForm');
  const credentialsMsg = document.getElementById('credentialsMsg');
  const credentialsSave = document.getElementById('credentialsSaveBtn');
  const passwordState = document.getElementById('passwordState');

  credentialsForm && credentialsForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearBanner(credentialsMsg);
    credentialsSave.disabled = true;
    credentialsSave.textContent = 'Updating';
    try {
      const response = await fetch('/profile/credentials', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: document.getElementById('cred_email').value.trim(),
          currentPassword: document.getElementById('cred_currentPassword').value,
          newPassword: document.getElementById('cred_newPassword').value
        })
      });
      const data = await response.json();
      if (!response.ok || !data.success) throw new Error(data.error || 'Could not update credentials.');
      updateProfileTexts({ email: data.user.email });
      if (passwordState) passwordState.textContent = data.user.hasPassword ? 'Password configured' : 'No password set yet';
      document.getElementById('cred_currentPassword').value = '';
      document.getElementById('cred_newPassword').value = '';
      setBanner(credentialsMsg, data.message || 'Credentials updated.', false);
    } catch (error) {
      setBanner(credentialsMsg, error.message || 'Network error while updating credentials.', true);
    }
    credentialsSave.disabled = false;
    credentialsSave.textContent = 'Update credentials';
  });

  const deleteAccountForm = document.getElementById('deleteAccountForm');
  const deleteMsg = document.getElementById('deleteMsg');
  const deleteAccountButton = document.getElementById('deleteAccountBtn');

  deleteAccountForm && deleteAccountForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearBanner(deleteMsg);
    deleteAccountButton.disabled = true;
    deleteAccountButton.textContent = 'Deleting';
    try {
      const response = await fetch('/profile/account', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          confirmText: document.getElementById('deleteConfirmText').value.trim(),
          currentPassword: document.getElementById('deleteCurrentPassword').value
        })
      });
      const data = await response.json();
      if (!response.ok || !data.success) throw new Error(data.error || 'Could not delete account.');
      window.location.href = data.redirect || '/login?message=account_removed';
      return;
    } catch (error) {
      setBanner(deleteMsg, error.message || 'Network error while deleting account.', true);
    }
    deleteAccountButton.disabled = false;
    deleteAccountButton.textContent = 'Delete account';
  });
})();
</script>
</body>
</html>