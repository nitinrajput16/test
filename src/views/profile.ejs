<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
        --bg: #07110d;
        --bg-soft: #0b1712;
        --panel: rgba(14, 29, 22, 0.88);
        --panel-strong: #10241b;
        --panel-alt: #132c21;
        --line: rgba(85, 190, 135, 0.18);
        --line-strong: rgba(85, 190, 135, 0.32);
        --text: #e5f1eb;
        --text-muted: #9ab5a8;
        --text-faint: #769182;
        --accent: #49c47f;
        --accent-strong: #71efab;
        --danger: #ff6d6d;
        --shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
        --sidebar-width: 258px;
        --radius-xl: 26px;
        --radius-lg: 18px;
    }

    html { scroll-behavior: smooth; }

    body {
        min-height: 100vh;
        font-family: "Segoe UI", system-ui, sans-serif;
        color: var(--text);
        background:
            radial-gradient(circle at top left, rgba(73, 196, 127, 0.18), transparent 30%),
            radial-gradient(circle at top right, rgba(113, 239, 171, 0.08), transparent 24%),
            linear-gradient(180deg, #06100c 0%, #08130f 45%, #06100c 100%);
        overflow-x: hidden;
    }

    body::before {
        content: "";
        position: fixed;
        inset: 0;
        background-image:
            linear-gradient(rgba(255, 255, 255, 0.012) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.012) 1px, transparent 1px);
        background-size: 22px 22px;
        mask-image: radial-gradient(circle at center, rgba(0, 0, 0, 0.9), transparent 85%);
        pointer-events: none;
    }

    a { color: inherit; text-decoration: none; }
    button, input { font: inherit; }

    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #08120e; }
    ::-webkit-scrollbar-thumb { background: rgba(73, 196, 127, 0.3); border-radius: 999px; }

    .pf-layout { display: flex; min-height: 100vh; }

    .pf-sidebar {
        position: fixed;
        inset: 0 auto 0 0;
        width: var(--sidebar-width);
        padding: 22px 18px;
        border-right: 1px solid var(--line);
        background: rgba(7, 17, 13, 0.82);
        backdrop-filter: blur(16px);
        display: flex;
        flex-direction: column;
        gap: 18px;
        z-index: 20;
    }

    .pf-brand,
    .pf-identity,
    .pf-topbar,
    .pf-mobile-nav,
    .pf-hero,
    .pf-metric-strip,
    .pf-card {
        border: 1px solid var(--line);
        background: var(--panel);
        backdrop-filter: blur(14px);
        box-shadow: var(--shadow);
    }

    .pf-brand {
        padding: 14px 14px 16px;
        border-radius: 18px;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), rgba(73, 196, 127, 0.05));
    }

    .pf-brand-name { font-size: 1.55rem; font-weight: 800; letter-spacing: -0.04em; }
    .pf-brand-name span { color: var(--accent-strong); }
    .pf-brand-sub { margin-top: 6px; color: var(--text-faint); font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.18em; }

    .pf-identity {
        padding: 16px 14px;
        border-radius: 18px;
        display: grid;
        grid-template-columns: 54px 1fr;
        gap: 12px;
        align-items: center;
    }

    .pf-avatar,
    .pf-top-avatar,
    .pf-friend-avatar { object-fit: cover; background: #102118; }
    .pf-avatar { width: 54px; height: 54px; border-radius: 16px; border: 1px solid var(--line-strong); }
    .pf-identity-name { font-weight: 700; font-size: 0.98rem; }
    .pf-identity-handle { margin-top: 3px; color: var(--text-muted); font-size: 0.8rem; }
    .pf-identity-meta { margin-top: 8px; font-size: 0.74rem; color: var(--text-faint); }

    .pf-nav { display: flex; flex-direction: column; gap: 6px; padding: 8px 0; }
    .pf-nav-group-label { margin: 4px 12px 8px; color: var(--text-faint); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.18em; }

    .pf-nav-link {
        width: 100%;
        border: 1px solid transparent;
        background: transparent;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border-radius: 14px;
        cursor: pointer;
        transition: 160ms ease;
        text-align: left;
    }

    .pf-nav-link:hover,
    .pf-nav-link:focus-visible { color: var(--text); background: rgba(255, 255, 255, 0.03); border-color: var(--line); outline: none; }
    .pf-nav-link.active { color: var(--text); background: linear-gradient(180deg, rgba(73, 196, 127, 0.14), rgba(73, 196, 127, 0.06)); border-color: var(--line-strong); }
    .pf-nav-icon { width: 18px; flex-shrink: 0; text-align: center; }
    .pf-nav-icon i { font-size: 0.92rem; }

    .pf-sidebar-footer {
        margin-top: auto;
        padding: 14px;
        border-radius: 16px;
        border: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.02);
        color: var(--text-faint);
        font-size: 0.76rem;
        line-height: 1.5;
    }

    .pf-main {
        margin-left: var(--sidebar-width);
        width: calc(100% - var(--sidebar-width));
        min-height: 100vh;
        padding: 26px 28px 40px;
    }

    .pf-main-shell {
      max-width: 1280px;
      margin: 0 auto;
    }

    .pf-navbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 18px;
      padding: 14px 18px;
      border-radius: 20px;
      border: 1px solid var(--line);
      background: rgba(8, 18, 14, 0.8);
      backdrop-filter: blur(16px);
      box-shadow: var(--shadow);
    }

    .pf-navbar-brand {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }

    .pf-navbar-brand-mark {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border-radius: 14px;
      background: linear-gradient(135deg, rgba(73, 196, 127, 0.2), rgba(113, 239, 171, 0.08));
      border: 1px solid var(--line-strong);
      color: var(--accent-strong);
      flex-shrink: 0;
    }

    .pf-navbar-brand-copy {
      min-width: 0;
    }

    .pf-navbar-brand-title {
      font-size: 0.98rem;
      font-weight: 700;
      letter-spacing: -0.03em;
    }

    .pf-navbar-brand-sub {
      margin-top: 3px;
      color: var(--text-faint);
      font-size: 0.76rem;
      white-space: nowrap;
    }

    .pf-navbar-links {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 10px;
      flex-wrap: wrap;
    }

    .pf-navbar-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 14px;
      border-radius: 999px;
      border: 1px solid transparent;
      color: var(--text-muted);
      background: transparent;
      transition: 160ms ease;
      white-space: nowrap;
    }

    .pf-navbar-link:hover,
    .pf-navbar-link:focus-visible {
      color: var(--text);
      border-color: var(--line);
      background: rgba(255, 255, 255, 0.03);
      outline: none;
    }

    .pf-navbar-link.active {
      color: var(--text);
      border-color: var(--line-strong);
      background: rgba(73, 196, 127, 0.1);
    }

    .pf-topbar {
      position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 22px;
        padding: 16px 20px;
        border-radius: 20px;
    }

    .pf-topbar-copy h1 { font-size: 1.1rem; font-weight: 700; letter-spacing: -0.03em; }
    .pf-topbar-copy p { margin-top: 4px; color: var(--text-muted); font-size: 0.84rem; }
    .pf-topbar-side { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
    .pf-status-pill { padding: 8px 12px; border-radius: 999px; border: 1px solid var(--line); background: rgba(73, 196, 127, 0.08); color: var(--accent-strong); font-size: 0.78rem; white-space: nowrap; }
    .pf-top-avatar { width: 42px; height: 42px; border-radius: 14px; border: 1px solid var(--line-strong); }

    .pf-summary { display: grid; grid-template-columns: 1.35fr 0.9fr; gap: 18px; margin-bottom: 22px; }

    .pf-hero { position: relative; overflow: hidden; border-radius: var(--radius-xl); padding: 26px; }
    .pf-hero::before { content: ""; position: absolute; inset: auto -10% -35% auto; width: 280px; height: 280px; border-radius: 50%; background: radial-gradient(circle, rgba(113, 239, 171, 0.18), transparent 70%); pointer-events: none; }
    .pf-kicker { display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px; border-radius: 999px; background: rgba(73, 196, 127, 0.11); border: 1px solid var(--line); color: var(--accent-strong); font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.12em; }
    .pf-hero-title { margin-top: 18px; font-size: clamp(1.85rem, 3vw, 2.55rem); line-height: 1.02; letter-spacing: -0.05em; }
    .pf-hero-title strong { color: var(--accent-strong); }
    .pf-hero-copy { margin-top: 14px; max-width: 660px; color: var(--text-muted); font-size: 0.96rem; line-height: 1.7; }
    .pf-hero-meta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
    .pf-chip { padding: 8px 12px; border-radius: 999px; border: 1px solid var(--line); background: rgba(255, 255, 255, 0.02); color: var(--text-muted); font-size: 0.8rem; }

    .pf-metric-strip { border-radius: var(--radius-xl); padding: 18px; display: grid; gap: 12px; align-content: start; }
    .pf-metric-item { padding: 14px 16px; border-radius: 16px; background: rgba(255, 255, 255, 0.025); border: 1px solid rgba(255, 255, 255, 0.03); }
    .pf-metric-label { color: var(--text-faint); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.15em; }
    .pf-metric-value { margin-top: 8px; font-size: 1.55rem; font-weight: 800; letter-spacing: -0.04em; }

    .pf-mobile-nav { display: none; padding: 10px; margin-bottom: 20px; border-radius: 18px; overflow-x: auto; }
    .pf-mobile-nav-track { display: flex; gap: 8px; min-width: max-content; }
    .pf-mobile-nav .pf-nav-link { border-radius: 999px; padding: 10px 14px; width: auto; }

    .pf-section { display: none; animation: pfFade 220ms ease; }
    .pf-section.active { display: block; }
    @keyframes pfFade { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    .pf-section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 18px; }
    .pf-section-kicker { color: var(--accent-strong); font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; }
    .pf-section-title { margin-top: 6px; font-size: clamp(1.35rem, 2vw, 1.8rem); letter-spacing: -0.04em; }
    .pf-section-copy { margin-top: 8px; color: var(--text-muted); line-height: 1.65; max-width: 760px; }
    .pf-section-tag { padding: 9px 13px; border-radius: 999px; border: 1px solid var(--line); background: rgba(255, 255, 255, 0.025); color: var(--text-muted); font-size: 0.78rem; white-space: nowrap; }

    .pf-grid { display: grid; gap: 18px; }
    .pf-grid.two { grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr); }
    .pf-grid.equal { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pf-card { border-radius: var(--radius-lg); padding: 20px; }
    .pf-card,
    .pf-file-item,
    .pf-friend-item,
    .pf-metric-item,
    .pf-highlight {
      transition: transform 160ms ease, border-color 160ms ease, background 160ms ease, box-shadow 160ms ease;
    }

    .pf-card:hover,
    .pf-card:focus-within {
      border-color: rgba(113, 239, 171, 0.22);
      box-shadow: 0 28px 70px rgba(0, 0, 0, 0.34);
    }

    .pf-file-item:hover,
    .pf-friend-item:hover,
    .pf-metric-item:hover,
    .pf-highlight:hover {
      transform: translateY(-1px);
      border-color: var(--line-strong);
      background: rgba(73, 196, 127, 0.06);
    }
    .pf-card-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 18px; }
    .pf-card-head h3 { font-size: 0.98rem; letter-spacing: -0.03em; }
    .pf-card-head p { margin-top: 6px; color: var(--text-faint); font-size: 0.8rem; }
    .pf-badge { padding: 6px 10px; border-radius: 999px; border: 1px solid var(--line); color: var(--text-muted); font-size: 0.74rem; background: rgba(255, 255, 255, 0.025); white-space: nowrap; }

    .pf-info-stack { display: grid; gap: 10px; }
    .pf-info-row { display: grid; grid-template-columns: 30px 1fr; gap: 12px; padding: 12px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.05); }
    .pf-info-row:last-child { border-bottom: none; }
    .pf-info-icon { width: 30px; height: 30px; display: grid; place-items: center; border-radius: 10px; background: rgba(73, 196, 127, 0.08); color: var(--accent-strong); font-size: 0.86rem; }
    .pf-info-icon i,
    .pf-file-mark i { font-size: 0.85rem; }
    .pf-info-label { color: var(--text-faint); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; }
    .pf-info-value { margin-top: 4px; color: var(--text); font-size: 0.94rem; line-height: 1.55; word-break: break-word; }

    .pf-action-list, .pf-split-actions { display: flex; flex-wrap: wrap; gap: 10px; }
    .pf-split-actions { margin-top: 18px; }

    .pf-btn,
    .pf-btn-secondary,
    .pf-btn-danger {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 0 16px;
        border-radius: 12px;
        border: 1px solid transparent;
        cursor: pointer;
        transition: 160ms ease;
        text-decoration: none;
        white-space: nowrap;
    }

    .pf-btn { background: linear-gradient(135deg, var(--accent), var(--accent-strong)); color: #07110d; font-weight: 700; }
    .pf-btn:hover, .pf-btn:focus-visible { transform: translateY(-1px); box-shadow: 0 12px 22px rgba(73, 196, 127, 0.22); outline: none; }
    .pf-btn-secondary { background: rgba(255, 255, 255, 0.025); border-color: var(--line); color: var(--text); }
    .pf-btn-secondary:hover, .pf-btn-secondary:focus-visible { border-color: var(--line-strong); background: rgba(73, 196, 127, 0.08); outline: none; }
    .pf-btn-danger { background: rgba(255, 109, 109, 0.12); border-color: rgba(255, 109, 109, 0.22); color: #ffc0c0; }
    .pf-btn-danger:hover, .pf-btn-danger:focus-visible { background: rgba(255, 109, 109, 0.18); outline: none; }

    .pf-file-list, .pf-friend-list { display: grid; gap: 10px; }
    .pf-file-item, .pf-friend-item { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 14px 16px; border-radius: 16px; border: 1px solid rgba(255, 255, 255, 0.04); background: rgba(255, 255, 255, 0.025); }
    .pf-file-meta, .pf-friend-main { display: flex; align-items: center; gap: 12px; min-width: 0; }
    .pf-file-mark, .pf-friend-avatar-wrap { width: 42px; height: 42px; border-radius: 14px; display: grid; place-items: center; background: rgba(73, 196, 127, 0.09); color: var(--accent-strong); flex-shrink: 0; }
    .pf-friend-avatar-wrap { overflow: hidden; border: 1px solid var(--line); }
    .pf-friend-avatar { width: 100%; height: 100%; }
    .pf-file-name, .pf-friend-name { font-size: 0.95rem; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pf-file-sub, .pf-friend-sub { margin-top: 4px; color: var(--text-faint); font-size: 0.8rem; }
    .pf-file-side { text-align: right; flex-shrink: 0; }
    .pf-file-language { display: inline-flex; padding: 5px 9px; border-radius: 999px; border: 1px solid var(--line); background: rgba(73, 196, 127, 0.08); color: var(--accent-strong); font-size: 0.72rem; text-transform: uppercase; }
    .pf-file-date { margin-top: 8px; color: var(--text-faint); font-size: 0.78rem; }
    .pf-empty { padding: 18px; border-radius: 16px; border: 1px dashed var(--line); background: rgba(255, 255, 255, 0.015); color: var(--text-muted); line-height: 1.65; }
    .pf-highlight-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .pf-highlight { padding: 16px; border-radius: 16px; border: 1px solid rgba(255, 255, 255, 0.04); background: rgba(255, 255, 255, 0.025); }
    .pf-highlight-label { color: var(--text-faint); font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.12em; }
    .pf-highlight-value { margin-top: 10px; font-size: 1.35rem; font-weight: 700; letter-spacing: -0.04em; }

    .pf-form { display: grid; gap: 14px; }
    .pf-field { display: grid; gap: 7px; }
    .pf-label { color: var(--text-muted); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.02em; }
    .pf-help { color: var(--text-faint); font-size: 0.76rem; line-height: 1.55; }
    .pf-input { width: 100%; min-width: 0; padding: 13px 14px; border-radius: 12px; border: 1px solid var(--line); background: rgba(7, 17, 13, 0.78); color: var(--text); transition: 160ms ease; }
    .pf-input:focus { border-color: var(--line-strong); outline: none; box-shadow: 0 0 0 3px rgba(73, 196, 127, 0.14); }
    .pf-inline { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; align-items: start; }
    .pf-banner { display: none; padding: 12px 14px; border-radius: 12px; border: 1px solid var(--line); font-size: 0.84rem; line-height: 1.55; }
    .pf-banner.success { display: block; background: rgba(73, 196, 127, 0.1); color: #bdf7d4; border-color: rgba(73, 196, 127, 0.24); }
    .pf-banner.error { display: block; background: rgba(255, 109, 109, 0.1); color: #ffd0d0; border-color: rgba(255, 109, 109, 0.24); }
    .pf-status-line { min-height: 20px; color: var(--text-faint); font-size: 0.78rem; }
    .pf-danger-zone { border: 1px solid rgba(255, 109, 109, 0.18); background: linear-gradient(180deg, rgba(255, 109, 109, 0.06), rgba(255, 109, 109, 0.03)); }
    .pf-footer { margin-top: 28px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--text-faint); font-size: 0.76rem; text-align: center; }

    @media (max-width: 1080px) {
        .pf-summary, .pf-grid.two, .pf-grid.equal { grid-template-columns: 1fr; }
    }

    @media (max-width: 860px) {
        .pf-sidebar { display: none; }
        .pf-main { margin-left: 0; width: 100%; padding: 18px 16px 28px; }
        .pf-mobile-nav { display: block; }
      .pf-navbar { padding: 14px; }
        .pf-topbar { top: 12px; padding: 14px 16px; flex-direction: column; align-items: flex-start; }
        .pf-topbar-side { width: 100%; justify-content: space-between; }
    }

    @media (max-width: 560px) {
        .pf-hero, .pf-card, .pf-metric-strip { padding: 16px; }
        .pf-file-item, .pf-friend-item, .pf-section-head { flex-direction: column; align-items: flex-start; }
        .pf-file-side { text-align: left; }
        .pf-inline { grid-template-columns: 1fr; }
        .pf-highlight-grid { grid-template-columns: 1fr; }
      .pf-navbar,
      .pf-navbar-links { align-items: flex-start; }
      .pf-navbar { flex-direction: column; }
      .pf-navbar-links { justify-content: flex-start; }
    }
    </style>
</head>
<body data-own-profile="<%= (typeof viewingOther === 'undefined' || !viewingOther) ? 'true' : 'false' %>">
<%
const ownProfile = typeof viewingOther === 'undefined' || !viewingOther;
const joinedDate = user.createdAt ? new Date(user.createdAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' }) : 'N/A';
const joinedMonth = user.createdAt ? new Date(user.createdAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'short' }) : 'N/A';
const providerLabel = user.provider === 'google' ? 'Google account' : user.provider === 'github' ? 'GitHub account' : 'Local account';
const recentFiles = Array.isArray(fileList) ? fileList.slice(0, 8) : [];
const friendItems = Array.isArray(friendsData) ? friendsData : [];
%>

<div class="pf-layout">
    <aside class="pf-sidebar">
        <div class="pf-brand">
            <div class="pf-brand-name">Code<span>plat</span></div>
            <div class="pf-brand-sub">Sectioned workspace</div>
        </div>

        <div class="pf-identity">
            <img class="pf-avatar" src="<%= user.avatar || '/images/favicon.ico' %>" alt="avatar" data-profile-avatar onerror="this.onerror=null;this.src='/images/favicon.ico'">
            <div>
                <div class="pf-identity-name" data-profile-name><%= user.displayName %></div>
                <div class="pf-identity-handle" data-profile-handle>@<%= user.username %></div>
                <div class="pf-identity-meta"><%= providerLabel %></div>
            </div>
        </div>

        <nav class="pf-nav" aria-label="Profile sections">
            <div class="pf-nav-group-label">Sections</div>
            <button type="button" class="pf-nav-link active" data-section-link="profile"><span class="pf-nav-icon"><i class="fa-regular fa-user"></i></span><span>Profile</span></button>
            <button type="button" class="pf-nav-link" data-section-link="editor"><span class="pf-nav-icon"><i class="fa-solid fa-code"></i></span><span>Editor</span></button>
            <button type="button" class="pf-nav-link" data-section-link="friends"><span class="pf-nav-icon"><i class="fa-solid fa-user-group"></i></span><span>Friends</span></button>
            <% if (ownProfile) { %>
            <button type="button" class="pf-nav-link" data-section-link="settings"><span class="pf-nav-icon"><i class="fa-solid fa-sliders"></i></span><span>Settings</span></button>
            <button type="button" class="pf-nav-link" data-section-link="logout"><span class="pf-nav-icon"><i class="fa-solid fa-right-from-bracket"></i></span><span>Log Out</span></button>
